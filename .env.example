# PostgreSQL connection string — required in production (Vercel).
# Works with Neon, Supabase (Session/Direct pooler), Railway, or self-hosted.
# Server-side only; never exposed to the browser.
#
# For local development point it at any local Postgres, e.g.:
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hotelmate"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/hotelmate?sslmode=require"
